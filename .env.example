# Application
APP_NAME=Tradin
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL — Supabase, Neon, Railway, etc.)
# For Supabase: use the Transaction pooler URI (port 6543), not the direct connection.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=5

# ── Persistence feature flags ───────────────────────────────────────────────
# Disable modules you don't need to reduce DB writes and storage growth.
ENABLE_ONCHAIN_PERSISTENCE=true
ENABLE_TOKEN_SEARCH_DB=true
ENABLE_NEWS_PERSISTENCE=true
ENABLE_AI_PERSISTENCE=true
ENABLE_SEARCH_HISTORY=true

# ── Retention (days) — old rows are purged daily at 02:30 UTC ───────────────
RETENTION_NEWS_DAYS=7
RETENTION_AI_SUMMARIES_DAYS=30
RETENTION_ONCHAIN_TRADES_DAYS=14
RETENTION_ONCHAIN_OHLCV_DAYS=90
RETENTION_ONCHAIN_SNAPSHOTS_DAYS=30
RETENTION_ONCHAIN_EVENTS_DAYS=30
RETENTION_ONCHAIN_METRICS_DAYS=90
RETENTION_SEARCH_HISTORY_DAYS=14
RETENTION_BROADCAST_LOGS_DAYS=30
RETENTION_STRATEGY_RUNS_DAYS=60

# ── Data provider switch ────────────────────────────────────────────────────
# Accepted values: coinbase | gate
# Set to "gate" to route all market data through Gate.io instead of Coinbase.
DATA_PROVIDER=coinbase

# Coinbase Advanced Trade (public endpoints - no API key required)
COINBASE_API_BASE_URL=https://api.coinbase.com/api/v3/brokerage
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com

# Gate.io Spot API (public endpoints - no API key required)
GATE_API_BASE_URL=https://api.gateio.ws/api/v4
GATE_WS_URL=wss://api.gateio.ws/ws/v4/
GATE_FUTURES_WS_URL=wss://fx-ws.gateio.ws/v4/ws/usdt
GATE_DELIVERY_WS_URL=wss://fx-ws.gateio.ws/v4/ws/delivery/usdt

# CORS — no trailing slash; must match the browser Origin header exactly
FRONTEND_URL=http://localhost:5173

# ── Auth / users ────────────────────────────────────────────────────────────
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRE_HOURS=72
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
RETENTION_ACTIVITY_DAYS=90
# Optional comma-separated extra origins (production Vercel URL, custom domains, etc.)
ALLOWED_ORIGINS=
# Regex for Vercel preview deployments; set empty to disable
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Cache TTL (seconds)
CACHE_TTL_PRODUCTS=60
CACHE_TTL_CANDLES_SHORT=30
CACHE_TTL_CANDLES_LONG=300

# Default products to pre-load
DEFAULT_PRODUCTS=BTC-USD,ETH-USD,SOL-USD,XRP-USD,DOGE-USD,ADA-USD,AVAX-USD,MATIC-USD,DOT-USD,LINK-USD

# Symbols tracked for AI analysis (comma-separated, no -USD suffix)
TRACKED_SYMBOLS=BTC,ETH,SOL,XRP,DOGE,ADA,AVAX,MATIC,DOT,LINK

# ── AI / News ──────────────────────────────────────────────────────────────

# OpenAI — required for AI summaries and sentiment analysis
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# gpt-4o-mini is recommended for cost efficiency (~$0.15 / 1M input tokens)
AI_MODEL=gpt-4o-mini
# How many minutes to cache an AI response before regenerating (default 60)
AI_CACHE_MINUTES=60

# GNews — news article feed (100 req/day free)
# Get key at: https://gnews.io/
GNEWS_API_KEY=

# ── Telegram Broadcasting ───────────────────────────────────────────────────

# Your Telegram Bot token — get one from @BotFather on Telegram
# Leave empty to disable the broadcast system entirely
TELEGRAM_BOT_TOKEN=

# Optional: default chat_id for quick test sends
# Can be a channel username (@mychannel) or numeric group id (-100123456789)
TELEGRAM_DEFAULT_CHAT_ID=

# Minimum seconds between broadcasts to the same channel (per-message dedup)
BROADCAST_COOLDOWN_SECONDS=30

# Seconds within which an identical message is considered a duplicate
BROADCAST_DEDUP_WINDOW_SECONDS=300

# Set to true to automatically broadcast strategy signals to Telegram
ENABLE_SIGNAL_BROADCAST=true

# Set to true to automatically broadcast AI insights to Telegram
ENABLE_AI_BROADCAST=false

# Maximum number of queued messages (excess are dropped)
BROADCAST_QUEUE_MAX_SIZE=1000

# ── On-chain Analytics ────────────────────────────────────────────────────────

# Dune Analytics — Ethereum/Base DEX swap data
# Get key at: https://dune.com/settings/api
DUNE_API_KEY=

# ETL sync interval in minutes (30 recommended for lighter Supabase usage)
ONCHAIN_SYNC_INTERVAL_MINUTES=30

# USD threshold for whale detection
WHALE_THRESHOLD_USD=50000

# Minimum smart money score (0-100)
SMART_MONEY_MIN_SCORE=80

# Tracked tokens for scheduled on-chain sync (optional override)
# Default list is built into the app — Troll, Rave, Labusdt, Pippinusdt, Power
ONCHAIN_TRACKED_TOKENS=

# ── Token Discovery / Search ──────────────────────────────────────────────────

# DexScreener public API (no key required)
DEXSCREENER_API_URL=https://api.dexscreener.com

# CoinGecko — optional API key for higher rate limits
# Get key at: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Search result cache TTL in minutes
TOKEN_SEARCH_CACHE_MINUTES=10

# ── Crypto discovery ────────────────────────────────────────────────────────
# In-memory cache only — no Supabase/Postgres writes for discovery scans.
# Automatic scan runs once daily (UTC). Use POST /api/discover/scan for manual refresh.
DISCOVERY_SCAN_HOUR=6
DISCOVERY_SCAN_MINUTE=0
DISCOVERY_CACHE_TTL_HOURS=48

# ── Free analytics APIs (no keys required) ────────────────────────────────
# /api/analytics/* uses these free public providers automatically:
#   Coinbase Advanced Trade, Gate.io, OKX, DefiLlama, DexScreener,
#   GeckoTerminal, CoinGecko, Alternative.me (Fear & Greed)
# Optional keys below only improve rate limits — not required for analytics.
